[Unit]
Description=skill-lib VM MCP control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vmmcp
Group=vmmcp
WorkingDirectory=/opt/vm-mcp
EnvironmentFile=-/etc/vm-mcp.env
# The bearer token is never an environment variable and never a file the
# vmmcp UID can open: the service manager opens the root-only 0600 file and
# hands it over as stdin, which server.py reads once and replaces with
# /dev/null. (A LoadCredential= copy would stay readable by same-UID
# shell_exec children for the whole service lifetime.)
StandardInput=file:/etc/credstore/vm-mcp-token
Environment=VM_MCP_AUTH_TOKEN_SOURCE=stdin
StandardOutput=journal
StandardError=journal
Environment=VM_MCP_ROOT=/srv/vm-mcp/workspace
Environment=VM_MCP_PROFILE=read-only
Environment=VM_MCP_PORT=8765
Environment=VM_MCP_ADMIN_SOCKET=/run/vm-mcp/admin.sock
Environment=PYTHONDONTWRITEBYTECODE=1
# Root gate outside the sandbox (+): shell profiles need Yama ptrace_scope >= 1,
# which ProcSubset=pid hides from the server. StandardInput= applies to this
# command too (systemd opens the token file again for it); the gate never
# reads it and replaces fd 0 with /dev/null. If it fails, server.py never runs.
ExecStartPre=+/opt/vm-mcp/.venv/bin/python -I /opt/vm-mcp/yama_gate.py
ExecStart=/opt/vm-mcp/.venv/bin/python /opt/vm-mcp/server.py
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/srv/vm-mcp/workspace
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
IPAddressDeny=169.254.169.254
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
