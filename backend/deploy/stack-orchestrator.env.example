# Install as /etc/stack-orchestrator.env with mode 0600.
# Prefer local PostgreSQL peer/socket auth: no database password is needed here.
STACK_DATABASE_URL=postgresql:///stack_orchestrator?host=/var/run/postgresql
STACK_RECEIPT_DIR=/var/lib/stack-orchestrator/receipts

# Bounded workspaces. The production worker accepts direct children only.
STACK_REPO_ROOT=/srv/stack-repos
STACK_ALLOWED_REPOS=skill-lib,metapat,ucns,edcm,pcea,ptcna
STACK_SKILL_LIB_ROOT=/srv/stack/skill-lib

STACK_LEASE_SECONDS=1800
STACK_COMMAND_TIMEOUT_SECONDS=900
STACK_VERIFY_TIMEOUT_SECONDS=900
STACK_POLL_SECONDS=5
PYTHONDONTWRITEBYTECODE=1

STACK_BACKUP_LOCAL_DIR=/var/backups/stack-orchestrator/postgres
# Must be a real independent mount/device; a same-disk directory fails closed.
STACK_BACKUP_MIRROR_ROOT=/mnt/stack-orchestrator-backups
STACK_BACKUP_LOCAL_RETENTION_DAYS=14
STACK_BACKUP_MIRROR_RETENTION_DAYS=60

# Restore drills must point at a disposable, non-production database.
STACK_RESTORE_TEST_DATABASE_URL=postgresql:///stack_orchestrator_restore_test?host=/var/run/postgresql
